# Токен бота, полученный у @BotFather
BOT_TOKEN=

# Строка подключения к PostgreSQL.
# Для docker compose (сервис db) оставьте как есть — только замените пароль при желании.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/beauty_demo

# Telegram ID администратора(ов) через запятую, например: 123456789,987654321
# Узнать свой ID можно у бота @userinfobot
ADMIN_IDS=

# Часовой пояс мастера
TIMEZONE=Asia/Yekaterinburg
